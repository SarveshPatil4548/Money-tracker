# ---- MySQL ----
# Copy this file to .env and fill in your real values.
# DB_PASSWORD may be empty if your MySQL root user has no password.
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password_here
DB_NAME=money_tracker

# ---- Flask ----
# Leave this placeholder: the app generates a strong key on first run and saves
# it here. Do not change it after that, or existing sessions become invalid.
FLASK_SECRET_KEY=replace-with-a-long-random-secret
PORT=5000
